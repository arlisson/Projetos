{
  "manifest_version": 3,
  "name": "Selecionar e Classificar Dados",
  "version": "0.1.0",
  "description": "Seleciona texto na página, identifica tipo (email/telefone/etc.) e permite copiar/salvar.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Capturar seleção",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
