{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",

    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "dialog:default",

    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://mypcards.com/**"
        },
        {
          "url": "https://www.ligayugioh.com.br/**"
        },
        {
          "url": "http://localhost:3001/**"
        }
      ],
      "deny": []
    },
    "http:allow-fetch"
  ]
}
